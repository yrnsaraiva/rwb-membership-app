# Copiar para .env (desenvolvimento) ou definir como variáveis no Railway.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troca-isto-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.runwithbroto.co.mz
SITE_URL=http://localhost:8000

# Base de dados (Railway injecta DATABASE_URL automaticamente ao ligar o Postgres).
# Sem DATABASE_URL, usa SQLite local.
# DATABASE_URL=postgres://user:pass@host:5432/rwb

# Cache opcional (ranking). Sem REDIS_URL, usa memória local.
# REDIS_URL=redis://default:pass@host:6379/0

# Email transaccional (Hostinger). Sem EMAIL_HOST, os emails aparecem na consola.
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=no-reply@runwithbroto.co.mz
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=RunWithBroto <no-reply@runwithbroto.co.mz>

# Regras de pontos (opcional)
# RWB_POINTS_PER_KM=10
# RWB_STREAK_BONUS_EVERY=7
# RWB_STREAK_BONUS_POINTS=50
# RWB_EVENT_CHECKIN_POINTS=100

# Loja
# RWB_SHOP_MPESA_NUMBER=84 000 0000
# RWB_SHOP_MPESA_NAME=RunWithBroto
# RWB_SHOP_BANK_DETAILS=BCI · NIB 0000 0000 0000 0000 0000 0
# RWB_SHOP_DELIVERY_FEE=150
# RWB_SHOP_HOLD_DAYS=3
# RWB_PREMIUM_SHOP_DISCOUNT=10

# Eventos vindos da API de bilhetes (ETK). Com ETK_BASE e ETK_API_KEY definidos, os eventos são criados na ETK
# e sincronizados (python manage.py sync_etk_events, de 10 em 10 min); o painel deixa de os criar.
# ETK_BASE=https://etk-api.up.railway.app
# ETK_API_KEY=etk_live_...
# ETK_PUBLIC_EVENT_URL=https://runwithbroto.co.mz/eventos/{id}   # página de compra do bilhete (o {id} é o EVNT… da ETK)
